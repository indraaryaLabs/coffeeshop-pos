# Postgres connection used by the app (src/lib/db) and seed scripts.
# On Supabase, use the transaction-pooler connection string with prepare: false.
DATABASE_URL="postgresql://postgres:<password>@<host>:<port>/<database>"

# Direct (non-pooled) connection used by drizzle-kit for migrations/push.
DIRECT_URL="postgresql://postgres:<password>@<host>:<port>/<database>"

# Supabase — used for product image uploads on the Storage bucket.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Origin of the app, used by Better Auth's client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local admin creation via `npm run create-admin`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

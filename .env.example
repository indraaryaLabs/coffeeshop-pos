# ─── Database (required) ───
# Any PostgreSQL 15+ instance: local Docker, Supabase, Neon, etc.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_pos
# Optional: a direct connection for Drizzle CLI if DATABASE_URL uses a pooler.
DIRECT_URL=

# ─── Auth ───
# Public origin of the app (used by the Better Auth client).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth signing secret. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ─── Image uploads (optional) ───
# Used when an admin uploads a product photo. Without it, new products
# fall back to /images/placeholder.svg.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Admin bootstrap (scripts/create-admin.ts) ───
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@theatelier.com
ADMIN_PASSWORD=change-me-to-a-strong-password
